# --- Tieco Tech additions (append to the .env.example Laravel generates) ---
APP_NAME="Tieco Tech"
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tieco
DB_USERNAME=
DB_PASSWORD=

# Private disk for customer attachments (keep it non-public)
TIECO_UPLOAD_DISK=local

# First admin, read once by AdminUserSeeder. Password must be 12+ chars. Never commit real values.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Mail is optional. Without a real provider, confirmations and quote emails are simply not sent.
MAIL_MAILER=log
